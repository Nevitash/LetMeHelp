{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Expo: Debug web",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:8081",
      "webRoot": "${workspaceFolder}",
      "preLaunchTask": "Expo: Start web",
      "sourceMaps": true,
      "smartStep": true
    },
    {
      "name": "Expo: Debug Android",
      "type": "expo",
      "request": "attach",
      "projectRoot": "${workspaceFolder}",
      "bundlerHost": "127.0.0.1",
      "bundlerPort": "8081",
      "preLaunchTask": "Expo: Start Android"
    },
    {
      "name": "Expo: Start dev server",
      "type": "node-terminal",
      "request": "launch",
      "command": "npm start",
      "cwd": "${workspaceFolder}"
    }
  ]
}
